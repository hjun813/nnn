# PostgreSQL connection string (used from the data-layer milestone)
DATABASE_URL=postgresql://applyflow:applyflow@localhost:5432/applyflow

# Authentication secret (generate a long random value in real environments)
AUTH_SECRET=replace-with-a-random-secret

# Public application URL for authentication callbacks
AUTH_URL=http://localhost:3000

# Protects scheduled internal endpoints
CRON_SECRET=replace-with-a-separate-random-secret

# AI provider key (not required for the manual-registration MVP)
OPENAI_API_KEY=

# Docker Compose overrides
POSTGRES_PASSWORD=applyflow
APP_PORT=3000
